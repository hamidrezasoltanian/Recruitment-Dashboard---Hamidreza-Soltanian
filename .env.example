# =============================================
# Recruitment Dashboard - Environment Variables
# Copy this file to .env and fill in the values
# =============================================

# --- Database ---
DB_PASSWORD=recruitment_pass_2024
DATABASE_URL=postgresql://recruitment_user:recruitment_pass_2024@localhost:5432/recruitment_db

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:5002

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# --- Redis (optional for caching) ---
REDIS_URL=redis://localhost:6379

# --- Email (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM=داشبورد استخدام <no-reply@yourcompany.com>

# --- AI (optional) ---
GEMINI_API_KEY=your_google_ai_api_key
