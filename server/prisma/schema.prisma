// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  password  String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  candidates Candidate[]
  comments   Comment[]
  history    HistoryEntry[]

  @@map("users")
}

model Candidate {
  id                String   @id @default(cuid())
  name              String
  email             String
  phone             String
  position          String
  stage             String
  source            String
  rating            Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  interviewDate     String?
  interviewTime     String?
  interviewTimeChanged Boolean @default(false)
  interviewer       String?
  hasResume         Boolean  @default(false)
  evaluation        String?
  
  // Relations
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments          Comment[]
  history           HistoryEntry[]
  testResults       TestResult[]
  resumeFiles       ResumeFile[]
  testFiles         TestFile[]
  interviewAnswers  InterviewQuestionAnswer[]

  @@map("candidates")
}

model Comment {
  id          String   @id @default(cuid())
  text        String
  createdAt   DateTime @default(now())
  
  // Relations
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model HistoryEntry {
  id          String   @id @default(cuid())
  action      String
  details     String?
  createdAt   DateTime @default(now())
  
  // Relations
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("history_entries")
}

model TestResult {
  id            String    @id @default(cuid())
  testId        String
  status        String    @default("not_sent") // not_sent, pending, passed, failed, review
  score         Int?
  notes         String?
  sentDate      DateTime?
  deadlineHours Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // File details for test answer/report
  filename      String?
  originalName  String?
  mimeType      String?
  size          Int?
  path          String?
  
  // Relations
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("test_results")
}

model ResumeFile {
  id          String   @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  path        String
  createdAt   DateTime @default(now())
  
  // Relations
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("resume_files")
}

model TestFile {
  id          String   @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  path        String
  testId      String
  createdAt   DateTime @default(now())
  
  // Relations
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("test_files")
}

model KanbanStage {
  id        String   @id @default(cuid())
  title     String
  isCore    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kanban_stages")
}

model Template {
  id        String   @id @default(cuid())
  name      String
  content   String
  type      String   // email, whatsapp
  stageId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("templates")
}

model CompanyProfile {
  id           String   @id @default(cuid())
  name         String
  website      String
  address      String
  phone        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  jobPositions JobPosition[]

  @@map("company_profiles")
}

model JobPosition {
  id                       String   @id @default(cuid())
  title                    String
  interviewDurationMinutes Int?
  scoreGuide               String?  // JSON: {"1":"...","2":"...","3":"...","4":"..."}
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  
  // Relations
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  sections         InterviewSection[]
  criteria         EvaluationCriterion[]

  @@map("job_positions")
}

model InterviewSection {
  id              String   @id @default(cuid())
  title           String
  durationMinutes Int      @default(5)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jobPositionId String
  jobPosition   JobPosition @relation(fields: [jobPositionId], references: [id], onDelete: Cascade)
  questions     InterviewScriptQuestion[]

  @@map("interview_sections")
}

model InterviewScriptQuestion {
  id        String   @id @default(cuid())
  text      String
  maxScore  Int      @default(4)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sectionId String
  section   InterviewSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers   InterviewQuestionAnswer[]

  @@map("interview_script_questions")
}

model InterviewQuestionAnswer {
  id        String   @id @default(cuid())
  score     Int?
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questionId  String
  question    InterviewScriptQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId      String?

  @@unique([candidateId, questionId])
  @@map("interview_question_answers")
}

model EvaluationCriterion {
  id          String   @id @default(cuid())
  title       String
  description String?
  maxScore    Int      @default(4)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobPositionId String
  jobPosition   JobPosition @relation(fields: [jobPositionId], references: [id], onDelete: Cascade)

  @@map("evaluation_criteria")
}

model TestLibraryItem {
  id        String   @id @default(cuid())
  name      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("test_library_items")
}

model Source {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("sources")
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  candidateId String?
  action      String
  metadata    String?  // JSON string
  timestamp   DateTime @default(now())

  @@map("analytics_events")
}

model PerformanceMetric {
  id        String   @id @default(cuid())
  operation String
  duration  Int      // in milliseconds
  metadata  String?  // JSON string
  timestamp DateTime @default(now())

  @@map("performance_metrics")
}

model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  context   String?  // JSON string
  userId    String?
  requestId String?
  timestamp DateTime @default(now())

  @@map("error_logs")
}

model ApplicationLog {
  id        String   @id @default(cuid())
  level     String   // info, warn, error, debug
  message   String
  metadata  String?  // JSON string
  userId    String?
  requestId String?
  timestamp DateTime @default(now())

  @@map("application_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // info, success, warning, error
  read      Boolean  @default(false)
  data      String?  // JSON string
  createdAt DateTime @default(now())

  @@map("notifications")
}
